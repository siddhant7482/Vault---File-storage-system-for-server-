# ---------------------------------------------------------------------------
# Index database. Postgres holds NO bytes — every row in it can be rebuilt by
# walking the object store (`pnpm scan`). Losing it costs a scan, not data.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://commandhq:localdev@localhost:5434/vault"

# ---------------------------------------------------------------------------
# Storage driver. The bytes are the source of truth in BOTH modes.
#
#   fs  — a directory on disk. Zero infrastructure, used for local dev.
#   s3  — any S3-compatible endpoint. Garage on the node; also MinIO, B2, R2.
#
# Switching drivers is this one variable plus a `pnpm scan`.
# ---------------------------------------------------------------------------
STORAGE_DRIVER="fs"

# --- fs driver ---
# Where the files actually live. Relative paths resolve from the repo root.
STORAGE_FS_ROOT=".vault-store"

# --- s3 driver (Garage on CT 10x) ---
S3_ENDPOINT="http://127.0.0.1:3900"
S3_REGION="garage"
S3_BUCKET="vault"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Garage and MinIO both need path-style addressing; AWS proper does not.
S3_FORCE_PATH_STYLE="true"

# ---------------------------------------------------------------------------
# Signs short-lived download links. With the fs driver this is what makes a
# local URL unforgeable; with s3 it is unused (S3 signs its own).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------
LINK_SIGNING_KEY=""

# ---------------------------------------------------------------------------
# Suggested filing. Reuses the OpenRouter key Warden already has — Vault only
# ever asks the model where a file should go, never what is in it.
# Leave blank and filing stays entirely manual; nothing else changes.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=""
OPENROUTER_FILING_MODEL="anthropic/claude-haiku-4.5"

# ---------------------------------------------------------------------------
# The tight ship. Vault refuses to grow past this, and the whole Map is drawn
# against it. Gigabytes.
# ---------------------------------------------------------------------------
VAULT_ALLOCATION_GB="30"

# A file untouched for this long counts as COLD.
VAULT_COLD_DAYS="365"
